# Never commit real credentials. Copy this file to .env for local development.
AI_EDUCATION_LLM_ENABLED=false
AI_EDUCATION_LLM_PROVIDER=openai
AI_EDUCATION_LLM_MODEL=
AI_EDUCATION_LLM_TEMPERATURE=0.3
AI_EDUCATION_LLM_TIMEOUT_SECONDS=90
AI_EDUCATION_ALLOW_RULE_FALLBACK=false
AI_EDUCATION_MAX_RETRIES=3
AI_EDUCATION_POLICY_CACHE_TTL_SECONDS=86400

# MySQL persistence. Password remains server-side and must never use a VITE_ prefix.
AI_EDUCATION_MYSQL_ENABLED=false
AI_EDUCATION_MYSQL_HOST=127.0.0.1
AI_EDUCATION_MYSQL_PORT=3306
AI_EDUCATION_MYSQL_USER=root
AI_EDUCATION_MYSQL_PASSWORD=
AI_EDUCATION_MYSQL_DATABASE=ai_education
AI_EDUCATION_MYSQL_CONNECT_TIMEOUT_SECONDS=5
AI_EDUCATION_AUTH_SESSION_HOURS=168

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=AI_Education

# Vite development proxy. Production builds default to an explicit demo mode.
VITE_AGENT_API_BASE_URL=/agent-api
VITE_AGENT_DEMO_MODE=false
